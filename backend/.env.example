# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/landslide_db

# JWT
JWT_SECRET_KEY=your-very-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# File storage
UPLOAD_DIR=uploads
BASE_URL=http://localhost:8000

# Twilio (optional — leave blank to use mock SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_BROADCAST_RECIPIENTS=+919999999999,+918888888888

# App
APP_ENV=development
ALLOW_EMPIRICAL_FALLBACK=true
MODEL_VERSION=2026-09-10

# Google Identity Services web client ID (safe to expose in the frontend as well)
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project"}

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
